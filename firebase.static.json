{
  "hosting": {
    "site": "signalledger-ai-builder-cup",
    "public": "demo",
    "ignore": [
      "firebase.json",
      "firebase.static.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
